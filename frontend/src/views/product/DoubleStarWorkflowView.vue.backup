}

function handleImageLoadError(event) {
  console.error('[handleImageLoadError] 图片加载失败:', event)
}

async function viewDetail(row) {
  console.log('[viewDetail] 点击详情:', row)
  try {
    currentWorkflow.value = await getWorkflowDetail(row.id)
    console.log('[viewDetail] 获取到详情:', currentWorkflow.value)
    detailDialogVisible.value = true
    console.log('[viewDetail] detailDialogVisible 设置为 true')
  } catch (error) {
    console.error('[viewDetail] 获取详情失败:', error)
    ElMessage.error('获取详情失败')
  }
}

function handleSizeChange(size) {
  pagination.page_size = size
  loadWorkflows(1)
}

async function loadUsers() {
  try {
    const res = await getUsers()
    const userData = res.results || res
    users.value = userData
    allUsers.value = userData
    console.log('[loadUsers] 用户列表加载成功:', users.value.length, '个用户')
  } catch (error) {
    console.error('[loadUsers] 加载用户失败:', error)
    ElMessage.error('加载用户列表失败')
  }
}

async function loadSuppliers() {
  try {
    const res = await getSupplierMerchandisers()
    suppliers.value = res
    console.log('[loadSuppliers] 供应商列表加载成功:', suppliers.value.length, '个供应商')
  } catch (error) {
    console.error('[loadSuppliers] 加载供应商失败:', error)
    ElMessage.error('加载供应商列表失败')
  }
}

// 大货生产入库
async function handleProductionInbound(row) {
  try {
    await ElMessageBox.confirm('确认入库？', '确认操作', { type: 'warning' })
    submitting.value = true
    const payload = {
      action: 'production_inbound',
      production_stage: 1
    }
    const response = await updateWorkflowStatus(row.id, payload)
    ElMessage.success(response.data?.message || '入库成功')
    await loadWorkflows(pagination.page)
  } catch (error) {
    if (error !== 'cancel') {
      console.error('[handleProductionInbound] 入库失败:', error)
      const errorMsg = error.response?.data?.message || error.message || '未知错误'
      ElMessage.error('入库失败: ' + errorMsg)
    }
  } finally {
    submitting.value = false
  }
}

function onSupplierChange(supplierName) {
  console.log('[onSupplierChange] 供应商变更:', supplierName)
  const supplier = suppliers.value.find(s => s.supplier_name === supplierName)
  if (supplier) {
    actionForm.merchandiser_name = supplier.merchandiser_name || ''
    console.log('[onSupplierChange] 自动获取跟单员:', actionForm.merchandiser_name)
  } else {
    actionForm.merchandiser_name = ''
    console.warn('[onSupplierChange] 未找到供应商对应的跟单员')
  }
}

async function deleteWorkflowItem(row) {
  try { await deleteWorkflow(row.id); ElMessage.success("删除成功"); await loadWorkflows(pagination.page) }
  catch { ElMessage.error("删除失败") }
}

// 加载工作流列表数据
async function loadWorkflows(page = pagination.page) {
  loading.value = true
  try {
    pagination.page = page
    const params = {
      page: pagination.page, page_size: pagination.page_size,
      q: filters.q, workflow_type: filters.workflow_type,
      merchandiser: filters.merchandiser,
      platform: filters.platform, development_rhythm: filters.development_rhythm,
      brand: 'double_star'
    }
    console.log('[loadWorkflows] 请求参数:', params)
    const res = await getWorkflows(params)
    console.log('[loadWorkflows] 响应结果:', res)
    workflows.value = res.results
    pagination.total = res.total
    console.log('[loadWorkflows] 加载完成，共', workflows.value.length, '条记录')
  } catch (error) {
    console.error('[loadWorkflows] 加载失败:', error)
    ElMessage.error('加载工作流列表失败')
  } finally { loading.value = false }
}

function getStageName(stage) {
  if (stage === 'eliminated') return '已淘汰'
  const map = {
    1: '部门审批人审核', 2: '跟单员下样品单', 3: '样品会确认', 4: '摄影部过白底',
    5: '填写初价', 6: '核算价格', 7: '审批核算价格', 8: '钉钉价格审批',
    9: '上传试穿报告', 10: '确认寄拍', 11: '文员审核', 12: '样品对接完成'
  }
  return map[stage] || stage
}

function getOrderStageName(orderStage) {
  const map = { 1: '电子订单制作完成', 2: '业务审核材质完成', 3: '运营审核数据价格完成', 4: '运营部门领导审核完成' }
  return map[orderStage] || '待处理'
}

function getProductionStageName(productionStage) {
  const map = { 0: '待入库', 1: '已入库' }
  return map[productionStage] || '待处理'
}

function getStageStatus(workflow, stage) {
  // 订单处理使用order_stage，其他流程使用current_stage
  const current = workflow.workflow_type === 'order' ? workflow.order_stage : workflow.current_stage
  console.log('[getStageStatus] workflow_type:', workflow.workflow_type, 'order_stage:', workflow.order_stage, 'current_stage:', workflow.current_stage, 'current:', current, 'stage:', stage)
  if (current === 'eliminated') {
    const eliminatedAt = parseInt(workflow.eliminate_stage || '3')
    if (stage === eliminatedAt) return 'rejected'
    if (stage < eliminatedAt) return 'completed'
    return 'pending'
  }
  const currentInt = parseInt(current)
  if (isNaN(currentInt)) return 'pending'
  if (currentInt > stage) return 'completed'
  if (currentInt === stage) return 'current'
  return 'pending'
}

function getHandlerName(workflow, stage) {
  const map = {
    1: workflow.approver_name, 2: workflow.merchandiser_name, 3: workflow.merchandiser_name,
    4: workflow.photographer_name, 5: workflow.merchandiser_name, 6: workflow.price_calculator_name,
    7: workflow.price_leader_name, 8: workflow.clerk_name, 9: workflow.merchandiser_name,
    10: workflow.photographer_name, 11: workflow.clerk_name
  }
  // 订单处理的handler都是文员
  if (workflow.workflow_type === 'order') {
    return workflow.clerk_name || '-'
  }
  return map[stage] || '-'
}

function getStageInfoHtml(workflow, stage) {
  const items = []
  
  // 订单处理阶段的显示信息
  if (workflow.workflow_type === 'order') {
    if (stage === 1) {
      if (workflow.order_created_time) items.push(`下单日期：${formatDateTime(workflow.order_created_time).split(' ')[0]}`)
      if (workflow.supplier) items.push(`供应商：${workflow.supplier}`)
      if (workflow.order_warehouse) items.push(`仓储方：${workflow.order_warehouse}`)
      if (workflow.order_items && workflow.order_items.length > 0) {
        const itemCount = workflow.order_items.length
        items.push(`订单明细：${itemCount}条`)
        // 显示第一条的工厂款号作为示例
        if (workflow.order_items[0]?.factory_style_number) {
          items.push(`工厂款号：${workflow.order_items[0].factory_style_number}`)
        }
      }
      if (workflow.order_created_time) items.push(`制作时间：${formatDateTime(workflow.order_created_time)}`)
    } else if (stage === 2) {
      if (workflow.order_material_comments) items.push(`审核意见：${workflow.order_material_comments}`)
    } else if (stage === 3) {
      if (workflow.order_data_comments) items.push(`审核意见：${workflow.order_data_comments}`)
    } else if (stage === 4) {
      if (workflow.order_leader_comments) items.push(`审核意见：${workflow.order_leader_comments}`)
    }
    return items.length ? items.join(' | ') : ''
  }
  
  // 样品对接阶段的显示信息
  if (stage === 1) {
    if (workflow.supplier) items.push(`供应商：${workflow.supplier}`)
    if (workflow.merchandiser_name) items.push(`跟单员：${workflow.merchandiser_name}`)
    if (workflow.approval_comments) items.push(`备注：${workflow.approval_comments}`)
  } else if (stage === 2) {
    if (workflow.expected_completion_time) items.push(`预计完成时间：${workflow.expected_completion_time}`)
    if (workflow.futures_spot_season) items.push(`适配期货/现货-季节：${workflow.futures_spot_season}`)
    if (workflow.photographer_name) items.push(`摄影师：${workflow.photographer_name}`)
    if (workflow.sample_order_remarks) items.push(`备注：${workflow.sample_order_remarks}`)
  } else if (stage === 4) {
    if (workflow.white_background_images?.length) items.push(`白底图：${workflow.white_background_images.length}张`)
    if (workflow.photographer_comments) items.push(`备注：${workflow.photographer_comments}`)
  } else if (stage === 5) {
    if (workflow.initial_price) items.push(`初期报价：¥${workflow.initial_price}`)
    if (workflow.final_price) items.push(`最终价格：¥${workflow.final_price}`)
    if (workflow.price_details) items.push(`价格明细：${workflow.price_details}`)
    if (workflow.price_submitted) items.push(`价格是否提交：${workflow.price_submitted}`)
    if (workflow.price_submit_date) items.push(`价格提交日期：${workflow.price_submit_date}`)
    if (workflow.price_approval_completed) items.push(`价格审批是否完成：${workflow.price_approval_completed}`)
    if (workflow.unordered_reason) items.push(`未下单原因：${workflow.unordered_reason}`)
    if (workflow.ds_six_images_uploaded) items.push(`双星6张图是否上传：${workflow.ds_six_images_uploaded}`)
    if (workflow.ds_six_images_qualified) items.push(`双星6张图是否合格：${workflow.ds_six_images_qualified}`)
    if (workflow.price_calculator_name) items.push(`核算人员：${workflow.price_calculator_name}`)
  } else if (stage === 6) {
    if (workflow.clerk_name) items.push(`文员：${workflow.clerk_name}`)
    if (workflow.price_leader_name) items.push(`直属领导：${workflow.price_leader_name}`)
  } else if (stage === 9) {
    if (workflow.try_on_report?.length) {
              const fileLinks = workflow.try_on_report.map(url => `<a href="${url.startsWith('http') ? url : url.startsWith('/media') ? url : '/api' + url}" target="_blank" class="text-blue-600 hover:underline">查看文件</a>`).join(' ')
              items.push(`试穿报告（${workflow.try_on_report.length}个）：${fileLinks}`)
            }
  } else if (stage === 10) {
    items.push(`是否寄拍：${workflow.need_photo_shoot || '-'}`)
    if (workflow.need_photo_shoot === '是') {
      if (workflow.need_white_bg_photo) items.push(`是否拍白底图：${workflow.need_white_bg_photo}`)
      if (workflow.white_bg_passed) items.push(`白底图是否通过：${workflow.white_bg_passed}`)
      if (workflow.white_bg_fail_reason) items.push(`白底图未过说明：${workflow.white_bg_fail_reason}`)
      if (workflow.has_try_on_report) items.push(`是否有试穿报告：${workflow.has_try_on_report}`)
      if (workflow.accessory_material) items.push(`辅料材质：${workflow.accessory_material}`)
      if (workflow.is_ordered) items.push(`是否下单：${workflow.is_ordered}`)
      if (workflow.ds_order_date) items.push(`下单日期：${workflow.ds_order_date}`)
      if (workflow.photo_shoot_date) items.push(`寄拍日期：${workflow.photo_shoot_date}`)
      if (workflow.photo_shoot_remarks) items.push(`寄拍备注：${workflow.photo_shoot_remarks}`)
    }
  }
  return items.length ? items.join(' | ') : ''
}

function getWorkflowStages(workflow) {
  // 根据workflow_type选择不同的阶段定义
  const stages = workflow.workflow_type === 'order' ? orderStages : dsStages

  if (workflow.current_stage === 'eliminated') {
    return stages.map((s) => ({
      name: s.name,
      status: s.stage === 3 ? 'rejected' : s.stage < 3 ? 'completed' : 'pending',
      handler: getHandlerName(workflow, s.stage)
    }))
  }
  return stages.map((s) => ({
    name: s.name,
    status: getStageStatus(workflow, s.stage),
    handler: getHandlerName(workflow, s.stage)
  }))
}

function canOperate(workflow) {
  if (!workflow) {
    console.warn('[canOperate] 工作流对象为空')
    return false
  }

  // 检查工作流状态
  if (workflow.status === 'completed' || workflow.status === 'rejected' || workflow.current_stage === 'eliminated') {
    return false
  }

  // 转换用户ID为数字，确保类型一致
  const uid = Number(userInfo.value?.id)
  if (!uid) {
    console.warn('[canOperate] 用户ID未找到')
    return false
  }

  // 转换阶段为字符串，确保比较一致
  const stage = String(workflow.current_stage)

  // 转换所有负责人ID为数字
  const approverId = Number(workflow.approver)
  const merchandiserId = Number(workflow.merchandiser)
  const photographerId = Number(workflow.photographer)
  const priceCalculatorId = Number(workflow.price_calculator)
  const priceLeaderId = Number(workflow.price_leader)
  const clerkId = Number(workflow.clerk)

  // 打印调试信息
  console.log('[canOperate] 权限检查:', {
    stage,
    uid,
    approverId,
    merchandiserId,
    photographerId,
    priceCalculatorId,
    priceLeaderId,
    clerkId,
    '阶段1匹配': stage === '1' && approverId === uid,
    '阶段2匹配': stage === '2' && merchandiserId === uid,
    '阶段3匹配': stage === '3' && merchandiserId === uid,
    '阶段4匹配': stage === '4' && photographerId === uid,
    '阶段5匹配': stage === '5' && merchandiserId === uid,
    '阶段6匹配': stage === '6' && priceCalculatorId === uid,
    '阶段7匹配': stage === '7' && priceLeaderId === uid,
    '阶段8匹配': stage === '8' && clerkId === uid,
    '阶段9匹配': stage === '9' && merchandiserId === uid,
    '阶段10匹配': stage === '10' && photographerId === uid,
    '阶段11匹配': stage === '11' && clerkId === uid
  })

  // 检查各阶段权限（使用严格相等比较）
  if (stage === '1' && approverId === uid) return true
  if (stage === '2' && merchandiserId === uid) return true
  if (stage === '3' && merchandiserId === uid) return true
  if (stage === '4' && photographerId === uid) return true
  if (stage === '5' && merchandiserId === uid) return true
  if (stage === '6' && priceCalculatorId === uid) return true
  if (stage === '7' && priceLeaderId === uid) return true
  if (stage === '8' && clerkId === uid) return true
  if (stage === '9' && merchandiserId === uid) return true
  if (stage === '10' && photographerId === uid) return true
  if (stage === '11' && clerkId === uid) return true

  return false
}

function getConfirmButtonText(workflow) {
  // 订单处理流程
  if (workflow?.workflow_type === 'order') {
    const orderStage = workflow?.order_stage
    if (orderStage === 1) return '制作订单'
    if (orderStage === 2) return '确认审核'
    if (orderStage === 3) return '确认审核'
    if (orderStage === 4) return '确认审核'
    return '确认'
  }
  
  // 样品对接流程
  const stage = workflow?.current_stage
  if (stage === '1') return '确认审核'
  if (stage === '2') return '确认下单'
  if (stage === '3') return '确认'
  if (stage === '4') return '确认上传白底'
  if (stage === '5') return '确认填写初价'
  if (stage === '6') return '确认核算价格'
  if (stage === '7') return '确认审批'
  if (stage === '8') return '确认审批完成'
  if (stage === '9') return '确认上传'
  if (stage === '10') return '确认寄拍'
  if (stage === '11') return '确认审核'
  return '确认'
}

function canOperateAtStage(workflow, stageToCheck) {
  if (!workflow) {
    console.warn('[canOperateAtStage] 工作流对象为空')
    return false
  }

  // 检查工作流状态
  if (workflow.status === 'completed' || workflow.status === 'rejected' || workflow.current_stage === 'eliminated') {
    return false
  }

  // 订单处理流程的权限检查
  if (workflow.workflow_type === 'order') {
    // 订单处理使用order_stage
    if (String(workflow.order_stage) !== String(stageToCheck)) {
      return false
    }

    const uid = Number(userInfo.value?.id)
    if (!uid) {
      console.warn('[canOperateAtStage] 用户ID未找到')
      return false
    }

    const clerkId = Number(workflow.clerk)
    // 订单处理所有阶段都是文员操作
    return clerkId === uid
  }

  // 样品对接流程的权限检查
  // 检查是否为当前阶段
  if (String(workflow.current_stage) !== String(stageToCheck)) {
    return false
  }

  // 转换用户ID为数字，确保类型一致
  const uid = Number(userInfo.value?.id)
  if (!uid) {
    console.warn('[canOperateAtStage] 用户ID未找到')
    return false
  }

  // 转换所有负责人ID为数字
  const approverId = Number(workflow.approver)
  const merchandiserId = Number(workflow.merchandiser)
  const photographerId = Number(workflow.photographer)
  const priceCalculatorId = Number(workflow.price_calculator)
  const priceLeaderId = Number(workflow.price_leader)
  const clerkId = Number(workflow.clerk)

  // 转换阶段为字符串，确保比较一致
  const stage = String(stageToCheck)

  // 检查特定阶段的权限
  if (stage === '1' && approverId === uid) return true
  if (stage === '2' && merchandiserId === uid) return true
  if (stage === '3' && merchandiserId === uid) return true
  if (stage === '4' && photographerId === uid) return true
  if (stage === '5' && merchandiserId === uid) return true
  if (stage === '6' && priceCalculatorId === uid) return true
  if (stage === '7' && priceLeaderId === uid) return true
  if (stage === '8' && clerkId === uid) return true
  if (stage === '9' && merchandiserId === uid) return true
  if (stage === '10' && photographerId === uid) return true
  if (stage === '11' && clerkId === uid) return true

  return false
}

function getConfirmButtonTextForStage(stage, workflowType = null) {
  // 订单处理流程的按钮文本
  if (workflowType === 'order') {
    if (stage === 1) return '订单制作'
    if (stage === 2) return '确认审核'
    if (stage === 3) return '确认审核'
    if (stage === 4) return '确认审核'
    return '确认'
  }
  // 样品对接流程的按钮文本
  if (stage === '1') return '确认审核'
  if (stage === '2') return '确认下单'
  if (stage === '3') return '确认'
  if (stage === '4') return '确认上传白底'
  if (stage === '5') return '确认填写初价'
  if (stage === '6') return '确认核算价格'
  if (stage === '7') return '确认审批'
  if (stage === '8') return '确认审批完成'
  if (stage === '9') return '确认上传'
  if (stage === '10') return '确认寄拍'
  if (stage === '11') return '确认审核'
  return '确认'
}

// 检查阶段是否需要填写表单
function needsFormForStage(stage, workflowType = null, orderStage = null) {
  // 订单处理流程
  if (workflowType === 'order') {
    // 订单处理阶段1和阶段3需要表单（电子订单制作、运营审核数据价格）
    return String(orderStage) === '1' || String(orderStage) === '3'
  }
  // 样品对接流程：需要表单的阶段：1, 2, 4, 5, 6, 9, 10
  return ['1', '2', '4', '5', '6', '9', '10'].includes(String(stage))
}

// 处理确认按钮点击
async function handleStageConfirm(stage) {
  const stageStr = String(stage)

  if (needsFormForStage(stageStr, currentWorkflow.value?.workflow_type, currentWorkflow.value?.order_stage)) {
    // 需要表单的阶段，打开对话框
    await openActionDialog()
  } else {
    // 不需要表单的阶段，直接提交
    const confirmMessages = {
      '3': '确认完成样品会确认？流程将进入下一阶段',
      '7': '确认审批通过核算价格？流程将进入下一阶段',
      '8': '确认完成钉钉价格审批？流程将进入下一阶段',
      '11': '确认完成文员审核？流程将完成'
    }

    const message = confirmMessages[stageStr] || '确认操作？流程将进入下一阶段'

    await ElMessageBox.confirm(message, "确认操作", { type: "warning" })
    await submitAction()
  }
}

// 直接提交指定阶段的操作（不需要表单的阶段）
async function submitActionForStage(stage) {
  const payload = { action: '' }

  if (stage === '3') {
    payload.action = 'ds_sample_confirm'
  } else if (stage === '7') {
    payload.action = 'ds_approve_calculated_price'
  } else if (stage === '8') {
    payload.action = 'ds_dingtalk_price_approval'
  } else if (stage === '11') {
    payload.action = 'ds_clerk_review'
  }

  submitting.value = true
  try {
    const response = await updateWorkflowStatus(currentWorkflow.value.id, payload)
    ElMessage.success(response.data?.message || '操作成功，流程已推进')

    // 重新加载数据
    await loadWorkflows(pagination.page)
    try {
      currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id)
    } catch (error) {
      console.error('[submitActionForStage] Failed to get workflow detail:', error)
    }
  } catch (error) {
    console.error('[submitActionForStage] 提交失败:', error)
    const errorMsg = error.response?.data?.message || error.message || '未知错误'
    ElMessage.error('操作失败: ' + errorMsg)
  } finally {
    submitting.value = false
  }
}

function openActionDialog() {
  resetActionForm()
  // 订单处理流程使用order_stage，其他流程使用current_stage
  const isOrderProcess = currentWorkflow.value?.workflow_type === 'order'
  const stage = isOrderProcess ? currentWorkflow.value?.order_stage : currentWorkflow.value?.current_stage
  const stageStr = String(stage)  // 确保是字符串
  // 订单处理使用getOrderStageName获取阶段名称
  const stageName = isOrderProcess ? getOrderStageName(stage) : getStageName(stage)
  actionDialogTitle.value = stageName
  console.log('[openActionDialog] 打开弹窗:', { isOrderProcess, stage, order_stage: currentWorkflow.value?.order_stage, workflow_type: currentWorkflow.value?.workflow_type })

  if (stageStr === '5' && currentWorkflow.value) {
    actionForm.initial_price = currentWorkflow.value.initial_price
    actionForm.final_price = currentWorkflow.value.final_price
    actionForm.price_details = currentWorkflow.value.price_details || ''
  }

  if (stageStr === '4' && currentWorkflow.value?.white_background_images) {
    actionForm.white_background_images = [...currentWorkflow.value.white_background_images]
    whiteBgFileList.value = currentWorkflow.value.white_background_images.map(url => ({
      name: '白底图',
      url: url
    }))
    console.log('[openActionDialog] 加载已有白底图:', actionForm.white_background_images)
  }

  if (stageStr === '10') {
    photoShootDialogVisible.value = true
    return
  }

  approveDialogVisible.value = true
}

function showPhotoShootForm() {
  photoShootDialogVisible.value = false
  actionDialogTitle.value = '确认寄拍 - 需要寄拍'
  approveDialogVisible.value = true
}

async function submitPhotoShoot(noNeed) {
  submitting.value = true
  try {
    const action = noNeed ? 'ds_confirm_photo_shoot' : 'ds_need_photo_shoot'
    const payload = { action }
    if (!noNeed) {
      Object.assign(payload, {
        need_white_bg_photo: actionForm.need_white_bg_photo,
        white_bg_passed: actionForm.white_bg_passed,
        white_bg_fail_reason: actionForm.white_bg_fail_reason,
        has_try_on_report: actionForm.has_try_on_report,
        accessory_material: actionForm.accessory_material,
        is_ordered: actionForm.is_ordered,
        ds_order_date: actionForm.ds_order_date,
        photo_shoot_date: actionForm.photo_shoot_date,
        photo_shoot_remarks: actionForm.photo_shoot_remarks
      })
    }
    const response = await updateWorkflowStatus(currentWorkflow.value.id, payload)
    ElMessage.success(response.data?.message || "操作成功")
    photoShootDialogVisible.value = false
    approveDialogVisible.value = false
    await loadWorkflows(pagination.page)
    try { currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id) } catch (error) { console.error('[submitPhotoShoot] Failed to get workflow detail:', error) }
  } catch (error) {
    console.error('[submitPhotoShoot] 提交失败:', error)
    const errorMsg = error.response?.data?.message || error.message || '未知错误'
    ElMessage.error('操作失败: ' + errorMsg)
  } finally {
    submitting.value = false
  }
}

// 专门处理阶段10寄拍表单提交的函数
async function submitPhotoShootForm() {
  console.log('[submitPhotoShootForm] 函数开始执行')
  submitting.value = true
  try {
    // 阶段10需要寄拍表单数据
    const action = 'ds_need_photo_shoot'
    const payload = {
      action,
      need_white_bg_photo: actionForm.need_white_bg_photo,
      white_bg_passed: actionForm.white_bg_passed,
      white_bg_fail_reason: actionForm.white_bg_fail_reason,
      has_try_on_report: actionForm.has_try_on_report,
      accessory_material: actionForm.accessory_material,
      is_ordered: actionForm.is_ordered,
      ds_order_date: actionForm.ds_order_date,
      photo_shoot_date: actionForm.photo_shoot_date,
      photo_shoot_remarks: actionForm.photo_shoot_remarks
    }

    console.log('[submitPhotoShootForm] 提交寄拍表单:', payload)
    console.log('[submitPhotoShootForm] actionForm内容:', actionForm)
    console.log('[submitPhotoShootForm] 工作流ID:', currentWorkflow.value?.id)

    const response = await updateWorkflowStatus(currentWorkflow.value.id, payload)
    console.log('[submitPhotoShootForm] 提交成功:', response)
    ElMessage.success(response.data?.message || "寄拍信息已提交")
    approveDialogVisible.value = false
    await loadWorkflows(pagination.page)
    try { currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id) } catch (error) { console.error('[submitPhotoShootForm] Failed to get workflow detail:', error) }
  } catch (error) {
    console.error('[submitPhotoShootForm] 提交失败:', error)
    console.error('[submitPhotoShootForm] 错误详情:', error.response?.data)
    const errorMsg = error.response?.data?.message || error.message || '未知错误'
    ElMessage.error('操作失败: ' + errorMsg)
  } finally {
    submitting.value = false
    console.log('[submitPhotoShootForm] 函数执行完成')
  }
}

async function handleOrderReject() {
  if (currentWorkflow.value?.workflow_type === 'order') {
    const orderStage = currentWorkflow.value?.order_stage
    if (orderStage >= 2) {
      await ElMessageBox.confirm("确认拒绝？订单处理流程将退回上一步", "拒绝确认", { type: "warning" })
      try {
        // 订单处理拒绝：将order_stage退回上一个阶段
        const response = await updateWorkflowStatus(currentWorkflow.value.id, { action: "ds_order_reject" })
        ElMessage.success(response.data?.message || "已拒绝，订单处理流程退回上一步")
        await loadWorkflows(pagination.page)
        try { currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id) } catch (error) { console.error('Failed to get workflow detail:', error) }
      } catch (error) {
        console.error('[handleOrderReject] 拒绝失败:', error)
        const errorMsg = error.response?.data?.message || error.message || '未知错误'
        ElMessage.error("操作失败: " + errorMsg)
      }
    }
  }
}

async function handleReject() {
  const stage = String(currentWorkflow.value?.current_stage)

  if (stage === '3') {
    await ElMessageBox.confirm("确认拒绝？该流程将被淘汰，不再继续", "淘汰确认", { type: "warning" })
    try {
      const response = await updateWorkflowStatus(currentWorkflow.value.id, { action: "ds_eliminate" })
      ElMessage.success(response.data?.message || "已淘汰该流程")
      await loadWorkflows(pagination.page)
      try { currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id) } catch (error) { console.error('Failed to get workflow detail:', error) }
    } catch (error) {
      console.error('[handleReject] 淘汰失败:', error)
      const errorMsg = error.response?.data?.message || error.message || '未知错误'
      ElMessage.error("操作失败: " + errorMsg)
    }
  } else {
    await ElMessageBox.confirm("确认拒绝？流程将退回上一步", "拒绝确认", { type: "warning" })
    try {
      const response = await updateWorkflowStatus(currentWorkflow.value.id, { action: "ds_reject" })
      ElMessage.success(response.data?.message || "已拒绝，流程退回上一步")
      await loadWorkflows(pagination.page)
      try { currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id) } catch (error) { console.error('Failed to get workflow detail:', error) }
    } catch (error) {
      console.error('[handleReject] 拒绝失败:', error)
      const errorMsg = error.response?.data?.message || error.message || '未知错误'
      ElMessage.error("操作失败: " + errorMsg)
    }
  }
}

async function submitAction() {
  const stage = String(currentWorkflow.value?.current_stage)  // 确保是字符串
  let action = ''
  const payload = {}  // 空对象，而不是 { action: '' }

  // 优先处理订单处理流程
  if (currentWorkflow.value?.workflow_type === 'order') {
    // 订单处理流程
    const orderStage = currentWorkflow.value?.order_stage
    if (orderStage === 1) {
      // 电子订单制作
      if (!actionForm.order_items || actionForm.order_items.length === 0) { ElMessage.warning('请至少添加一条订单明细'); submitting.value = false; return }
      if (!actionForm.warehouse) { ElMessage.warning('请填写仓储方'); submitting.value = false; return }
      action = 'create_ds_electronic_order'
      payload.action = action
      payload.order_items = actionForm.order_items
      payload.warehouse = actionForm.warehouse
    } else if (orderStage === 2) {
      // 业务审核材质
      action = 'ds_approve_order_material'
      payload.action = action
      payload.comments = actionForm.comments
    } else if (orderStage === 3) {
      // 运营审核数据价格
      action = 'ds_approve_data_price'
      payload.action = action
      payload.comments = actionForm.comments
    } else if (orderStage === 4) {
      // 运营部门领导审核
      action = 'ds_approve_data_price_leader'
      payload.action = action
      payload.comments = actionForm.comments
    } else {
      ElMessage.error(`未知的订单处理阶段: ${orderStage}`)
      submitting.value = false
      return
    }
  } else if (stage === '1') {
    if (!actionForm.supplier) {
      ElMessage.warning('请选择供应商'); submitting.value = false; return
    }
    action = 'ds_approve'
    payload.action = action
    payload.supplier = actionForm.supplier
    payload.comments = actionForm.comments
  } else if (stage === '2') {
    if (!actionForm.expected_completion_time || !actionForm.photographer) { ElMessage.warning('请填写必填项'); submitting.value = false; return }
    action = 'ds_place_sample_order'
    payload.action = action
    payload.expected_completion_time = actionForm.expected_completion_time
    payload.futures_spot_season = actionForm.futures_spot_season
    payload.photographer = actionForm.photographer
    payload.comments = actionForm.comments
  } else if (stage === '3') {
    action = 'ds_sample_confirm'
    payload.action = action
  } else if (stage === '4') {
    console.log('[submitAction] 阶段4提交，白底图数量:', actionForm.white_background_images.length)
    console.log('[submitAction] 白底图列表:', actionForm.white_background_images)
    action = 'ds_photographer_white_bg'
    payload.action = action
    payload.white_background_images = actionForm.white_background_images
    payload.comments = actionForm.comments
  } else if (stage === '5') {
    if (!actionForm.initial_price || !actionForm.final_price || !actionForm.price_calculator) { ElMessage.warning('请填写必填项'); submitting.value = false; return }
    action = 'ds_fill_initial_price'
    payload.action = action
    payload.initial_price = actionForm.initial_price
    payload.final_price = actionForm.final_price
    payload.price_details = actionForm.price_details
    payload.price_submitted = actionForm.price_submitted
    payload.price_submit_date = actionForm.price_submit_date
    payload.price_approval_completed = actionForm.price_approval_completed
    payload.unordered_reason = actionForm.unordered_reason
    payload.ds_six_images_uploaded = actionForm.ds_six_images_uploaded
    payload.ds_six_images_qualified = actionForm.ds_six_images_qualified
    payload.price_calculator = actionForm.price_calculator
  } else if (stage === '6') {
    if (!actionForm.clerk || !actionForm.price_leader) { ElMessage.warning('请选择文员和直属领导'); submitting.value = false; return }
    action = 'ds_calculate_price'
    payload.action = action
    payload.clerk = actionForm.clerk
    payload.price_leader = actionForm.price_leader
  } else if (stage === '7') {
    action = 'ds_approve_calculated_price'
    payload.action = action
  } else if (stage === '8') {
    action = 'ds_dingtalk_price_approval'
    payload.action = action
    } else if (stage === '9') {
    action = 'ds_upload_try_on_report'
    payload.action = action
    payload.try_on_report = actionForm.try_on_report
  } else if (stage === '10') {
    // 阶段10通过submitPhotoShootForm()函数处理，不应该到达这里
    ElMessage.error('阶段10应该通过寄拍表单提交')
    submitting.value = false
    return
  } else if (stage === '11') {
    action = 'ds_clerk_review'
    payload.action = action
    payload.comments = actionForm.comments
  } else if (currentWorkflow.value?.workflow_type === 'order') {
    // 订单处理流程
    const orderStage = currentWorkflow.value?.order_stage
    if (orderStage === 1) {
      // 电子订单制作
      if (!actionForm.order_items_array || actionForm.order_items_array.length === 0) { ElMessage.warning('请至少添加一条订单明细'); submitting.value = false; return }
      if (!actionForm.warehouse) { ElMessage.warning('请选择仓库'); submitting.value = false; return }
      action = 'create_ds_electronic_order'
      payload.action = action
      payload.order_items = actionForm.order_items_array
      payload.warehouse = actionForm.warehouse
    } else if (orderStage === 2) {
      // 业务审核材质
      action = 'ds_approve_order_material'
      payload.action = action
      payload.comments = actionForm.comments
    } else if (orderStage === 3) {
      // 运营审核数据价格
      action = 'ds_approve_data_price'
      payload.action = action
      payload.comments = actionForm.comments
    } else if (orderStage === 4) {
      // 运营部门领导审核
      action = 'ds_approve_data_price_leader'
      payload.action = action
      payload.comments = actionForm.comments
    } else {
      ElMessage.error(`未知的订单处理阶段: ${orderStage}`)
      submitting.value = false
      return
    }
  }

  // 最终检查action是否设置成功
  if (!action) {
    ElMessage.error('操作类型未设置，请重试')
    submitting.value = false
    return
  }

  submitting.value = true
  try {
    const response = await updateWorkflowStatus(currentWorkflow.value.id, payload)
    ElMessage.success(response.data?.message || "操作成功")
    approveDialogVisible.value = false
    await loadWorkflows(pagination.page)
    try {
      currentWorkflow.value = await getWorkflowDetail(currentWorkflow.value.id)
    } catch (error) {
      console.error('[submitAction] Failed to get workflow detail:', error)
    }
  } catch (error) {
    console.error('[submitAction] 提交失败:', error)
    const errorMsg = error.response?.data?.message || error.message || '未知错误'
    ElMessage.error('操作失败: ' + errorMsg)
  } finally {
    submitting.value = false
  }
}

// 统一的确认按钮点击处理函数
async function handleConfirmClick() {
  // 订单处理流程使用order_stage，其他流程使用current_stage
  const isOrderProcess = currentWorkflow.value?.workflow_type === 'order'
  const stage = isOrderProcess ? String(currentWorkflow.value?.order_stage) : String(currentWorkflow.value?.current_stage)
  console.log('[handleConfirmClick] 确认按钮被点击:', { stage, isOrderProcess, currentWorkflow: currentWorkflow.value })

  // 阶段10（确认寄拍）需要调用submitPhotoShootForm
  if (stage === '10') {
    await submitPhotoShootForm()
  } else {
    await submitAction()
  }
}

function selectBrand(brand) {
  currentBrand.value = brand
  loadWorkflows(1)
}

function selectWorkflowType(type) {
  filters.workflow_type = type
  loadWorkflows(1)
}

function openCreateWorkflowDialog() {
  createDialogVisible.value = true
}

async function submitCreateForm() {
  try {
    await createFormRef.value.validate()
    submitting.value = true

    const formData = {
      ...createForm,
      workflow_type: 'sample',
      status: 'pending',
      current_stage: '1',
      progress: 0,
      brand: 'double_star'
    }

    const response = await createWorkflow(formData)
    ElMessage.success(response.data?.message || "工作流创建成功")
    createDialogVisible.value = false

    // 重置表单
    createFormRef.value.resetFields()
    imageFileList.value = []

    await loadWorkflows(pagination.page)
  } catch (error) {
    if (error !== 'cancel') {
      console.error('[submitCreateForm] 创建失败:', error)
      const errorMsg = error.response?.data?.message || error.message || '创建失败'
      ElMessage.error(errorMsg)
    }
  } finally {
    submitting.value = false
  }
}

function resetFilters() {
  filters.q = ""
  filters.workflow_type = "sample"
  filters.merchandiser = null
  filters.platform = null
  filters.development_rhythm = null
  loadWorkflows(1)
}

onMounted(async () => {
  await Promise.all([loadUsers(), loadSuppliers(), loadWorkflows()])
})
</script>
