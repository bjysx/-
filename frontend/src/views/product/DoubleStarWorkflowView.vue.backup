  { stage: 2, name: "跟单员下样品单", handler: true, stageInfo: true },
  { stage: 3, name: "样品会确认", handler: true, stageInfo: false },
  { stage: 4, name: "摄影部过白底", handler: true, stageInfo: true },
  { stage: 5, name: "填写初价", handler: true, stageInfo: true },
  { stage: 6, name: "核算价格", handler: true, stageInfo: true },
  { stage: 7, name: "审批核算价格", handler: true, stageInfo: false },
  { stage: 8, name: "钉钉价格审批", handler: true, stageInfo: false },
