<template>
  <div :class="props.embedded ? '' : 'page-shell'">
    <section :class="props.embedded ? '' : 'page-card'">
      <!-- 品牌选择 -->
      <div v-if="!props.embedded" class="mb-5">
        <div class="flex items-center gap-3">
          <span class="text-base font-semibold text-gray-700">品牌：</span>
          <div class="flex gap-2">
            <el-button :type="currentBrand === '全部' ? 'primary' : 'default'" round @click="selectBrand('全部')">全部</el-button>
            <el-button :type="currentBrand === '白牌' ? 'primary' : 'default'" round @click="selectBrand('白牌')">白牌</el-button>
            <el-button :type="currentBrand === '双星' ? 'primary' : 'default'" round @click="selectBrand('双星')">双星</el-button>
            <el-button :type="currentBrand === '雅鹿' ? 'primary' : 'default'" round @click="selectBrand('雅鹿')">雅鹿</el-button>
            <el-button :type="currentBrand === 'FKO' ? 'primary' : 'default'" round @click="selectBrand('FKO')">FKO</el-button>
          </div>
        </div>
      </div>

      <div class="mb-5">
        <div class="flex items-center gap-3">
          <span class="text-base font-semibold text-gray-700">进度：</span>
          <div class="flex gap-2">
            <el-button :type="filters.workflow_type === 'sample' ? 'primary' : 'default'" round @click="selectWorkflowType('sample')">样品对接</el-button>
            <el-button :type="filters.workflow_type === 'order' ? 'primary' : 'default'" round @click="selectWorkflowType('order')">订单处理</el-button>
            <el-button :type="filters.workflow_type === 'production' ? 'primary' : 'default'" round @click="selectWorkflowType('production')">大货生产</el-button>
          </div>
        </div>
      </div>

      <div class="mb-5 p-4 bg-gray-50 rounded-lg">
        <el-form :inline="true" :model="filters" class="w-full">
          <el-form-item class="!mb-2 md:!mb-0">
            <el-input v-model="filters.q" clearable placeholder="搜索产品名称" @keyup.enter="loadWorkflows(1)" class="w-[200px]" />
          </el-form-item>
          <el-form-item class="!mb-2 md:!mb-0">
            <el-select v-model="filters.merchandiser" clearable placeholder="跟单员" class="w-[140px]">
              <el-option v-for="u in users" :key="u.id" :label="u.nickname" :value="u.id" />
            </el-select>
          </el-form-item>
          <el-form-item class="!mb-2 md:!mb-0">
            <el-select v-model="filters.platform" clearable placeholder="平台" class="w-[140px]">
              <el-option label="淘宝" value="淘宝" />
              <el-option label="京东" value="京东" />
              <el-option label="拼多多" value="拼多多" />
              <el-option label="抖音" value="抖音" />
            </el-select>
          </el-form-item>
          <el-form-item class="!mb-2 md:!mb-0">
            <el-select v-model="filters.development_rhythm" clearable placeholder="开发节奏" class="w-[140px]">
              <el-option label="快速开发" value="快速开发" />
              <el-option label="常规开发" value="常规开发" />
              <el-option label="缓慢开发" value="缓慢开发" />
            </el-select>
          </el-form-item>
          <el-form-item class="!mb-2 md:!mb-0">
            <el-button v-if="filters.workflow_type === 'sample'" type="primary" :icon="Plus" @click="openCreateWorkflowDialog">发起流程</el-button>
            <el-button type="success" @click="loadWorkflows(1)">查询</el-button>
            <el-button @click="resetFilters">重置</el-button>
          </el-form-item>
        </el-form>
      </div>

      <el-table v-loading="loading" :data="workflows" stripe row-key="id">
        <el-table-column type="expand">
          <template #default="{ row }">
            <div class="p-4 bg-gray-50">
              <!-- 流程进度 -->
              <div class="mt-4 border-t pt-4">
                <h5 class="text-sm font-semibold mb-3">流程进度</h5>
                <div class="flex items-center justify-between bg-white p-3 rounded-lg shadow-sm">
                  <div v-for="(stage, index) in getWorkflowStages(row)" :key="index" 
                       :class="['flex flex-col items-center flex-1', index < getWorkflowStages(row).length - 1 ? 'relative' : '']">
                    <div :class="['w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium z-10',
                      stage.status === 'completed' ? 'bg-green-500 text-white' :
                      stage.status === 'current' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-500']">
                      {{ stage.status === 'completed' ? '✓' : stage.status === 'current' ? '●' : index + 1 }}
                    </div>
                    <span :class="['text-xs mt-1 text-center', stage.status === 'current' ? 'text-blue-600 font-medium' : 'text-slate-600']">
                      {{ stage.name }}
                    </span>
                    <span v-if="stage.handler" class="text-xs text-slate-400 mt-0.5">{{ stage.handler }}</span>
                    <!-- 连接线 -->
                    <div v-if="index < getWorkflowStages(row).length - 1"
                         :class="['absolute top-4 left-1/2 w-full h-0.5 -z-0',
                          stage.status === 'completed' && getWorkflowStages(row)[index + 1].status !== 'pending' ? 'bg-green-400' : 'bg-gray-200']"
                         style="width: calc(100% - 2rem); left: calc(50% + 1rem);"></div>
                  </div>
                </div>
              </div>

              <!-- 图片预览 -->
              <div v-if="row.images && row.images.length > 0" class="mt-4 border-t pt-4">
                <h5 class="text-sm font-semibold mb-2">产品图片</h5>
                <div class="flex flex-wrap gap-2">
                  <el-image
                    v-for="(image, imgIndex) in row.images.slice(0, 6)"
                    :key="imgIndex"
                    :src="image.startsWith('http') ? image : `/api${image}`"
                    fit="cover"
                    class="w-16 h-16 object-cover rounded cursor-pointer hover:opacity-80 transition-opacity"
                    :preview-src-list="row.images.map(img => img.startsWith('http') ? img : `/api${img}`)"
                    :initial-index="imgIndex"
                    preview-teleported
                  />
                  <span v-if="row.images.length > 6" class="w-16 h-16 flex items-center justify-center bg-gray-100 rounded text-xs text-slate-500">
                    +{{ row.images.length - 6 }}
                  </span>
                </div>
              </div>
            </div>
          </template>
        </el-table-column>

        <template v-if="filters.workflow_type === 'sample'">
          <!-- 图片放第一 -->
          <el-table-column label="图片" width="80">
            <template #default="{ row }">
              <div v-if="row.images && row.images.length > 0" class="flex gap-1">
                <el-image v-for="(img, index) in row.images.slice(0, 2)" :key="index"
                  :src="img.startsWith('http') ? img : img.startsWith('/media') ? img : `/api${img}`"
                  :preview-src-list="row.images.map(i => i.startsWith('http') ? i : i.startsWith('/media') ? i : `/api${i}`)"
                  :initial-index="index" fit="cover" class="w-10 h-10 rounded border cursor-pointer" @error="handleImageLoadError" />
              </div>
              <span v-else class="text-xs text-slate-400">无</span>
            </template>
          </el-table-column>
          <!-- 平台方放第二 - 双星使用 selected_platform -->
          <el-table-column label="平台方" width="90">
            <template #default="{ row }">{{ row.selected_platform || '-' }}</template>
          </el-table-column>
          <el-table-column label="报备ID" width="90">
            <template #default="{ row }">{{ row.report_id || '-' }}</template>
          </el-table-column>
          <el-table-column label="货号" width="90">
            <template #default="{ row }">{{ row.article_number || '-' }}</template>
          </el-table-column>
          <el-table-column label="当前阶段" width="120">
            <template #default="{ row }">
              <span :class="['text-sm font-medium', row.current_stage === 'eliminated' ? 'text-red-600' : 'text-blue-600']">{{ getStageName(row.current_stage) }}</span>
            </template>
          </el-table-column>
          <el-table-column label="部门审批人" width="90">
            <template #default="{ row }">{{ row.approver_name || '-' }}</template>
          </el-table-column>
          <el-table-column label="申请人" width="70">
            <template #default="{ row }">{{ row.applicant_name || '-' }}</template>
          </el-table-column>
          <el-table-column label="申请时间" width="130">
            <template #default="{ row }">
              <span class="text-xs text-slate-500">{{ formatDateTime(row.application_time) }}</span>
            </template>
          </el-table-column>
        </template>

        <template v-if="filters.workflow_type === 'order'">
          <el-table-column label="报备ID" width="90">
            <template #default="{ row }">{{ row.report_id || '-' }}</template>
          </el-table-column>
          <el-table-column label="货号" width="90">
            <template #default="{ row }">{{ row.article_number || '-' }}</template>
          </el-table-column>
          <el-table-column label="当前阶段" width="120">
            <template #default="{ row }">
              <span class="text-sm font-medium text-blue-600">{{ getOrderStageName(row.order_stage) }}</span>
            </template>
          </el-table-column>
          <el-table-column label="跟单员" width="80">
            <template #default="{ row }">{{ row.merchandiser_name || '-' }}</template>
          </el-table-column>
          <el-table-column label="操作" width="100" fixed="right" align="center">
            <template #default="{ row }">
              <el-button type="primary" link size="small" @click="viewDetail(row)">详情</el-button>
              <el-popconfirm title="确定删除？" @confirm="deleteWorkflowItem(row)">
                <template #reference><el-button type="danger" link size="small">删除</el-button></template>
              </el-popconfirm>
            </template>
          </el-table-column>
        </template>

        <template v-if="filters.workflow_type === 'production'">
          <el-table-column label="报备ID" width="90">
            <template #default="{ row }">{{ row.report_id || '-' }}</template>
          </el-table-column>
          <el-table-column label="货号" width="90">
            <template #default="{ row }">{{ row.article_number || '-' }}</template>
          </el-table-column>
          <el-table-column label="当前阶段" width="120">
            <template #default="{ row }">
              <span class="text-sm font-medium text-blue-600">{{ getProductionStageName(row.production_stage) }}</span>
            </template>
          </el-table-column>
          <el-table-column label="跟单" width="80">
            <template #default="{ row }">{{ row.merchandiser_name || '-' }}</template>
          </el-table-column>
          <el-table-column label="供应商" width="100">
            <template #default="{ row }">{{ row.supplier || '-' }}</template>
          </el-table-column>
          <el-table-column label="仓储方" width="100">
            <template #default="{ row }">{{ row.order_warehouse || '-' }}</template>
          </el-table-column>
          <el-table-column label="工厂款号" width="120">
            <template #default="{ row }">
              <span v-if="row.order_items && row.order_items.length > 0">
                {{ row.order_items.map(item => item.factory_style_number).filter(Boolean).join(', ') || '-' }}
              </span>
              <span v-else>-</span>
            </template>
          </el-table-column>
          <el-table-column label="操作" width="150" fixed="right" align="center">
            <template #default="{ row }">
              <el-button type="primary" link size="small" @click="viewDetail(row)">详情</el-button>
              <el-popconfirm title="确定删除？" @confirm="deleteWorkflowItem(row)">
                <template #reference><el-button type="danger" link size="small">删除</el-button></template>
              </el-popconfirm>
              <el-button type="success" link size="small" @click="handleProductionInbound(row)">入库</el-button>
            </template>
          </el-table-column>
        </template>

        <template v-if="filters.workflow_type === 'sample'">
          <el-table-column label="图片" width="80">
            <template #default="{ row }">
              <div v-if="row.images && row.images.length > 0" class="flex gap-1">
                <el-image v-for="(img, index) in row.images.slice(0, 2)" :key="index"
                  :src="img.startsWith('http') ? img : img.startsWith('/media') ? img : `/api${img}`"
                  :preview-src-list="row.images.map(i => i.startsWith('http') ? i : i.startsWith('/media') ? i : `/api${i}`)"
                  :initial-index="index" fit="cover" class="w-10 h-10 rounded border cursor-pointer" @error="handleImageLoadError" />
              </div>
              <span v-else class="text-xs text-slate-400">无</span>
            </template>
          </el-table-column>
          <el-table-column label="操作" width="100" fixed="right" align="center">
            <template #default="{ row }">
              <el-button type="primary" link size="small" @click="viewDetail(row)">详情</el-button>
              <el-popconfirm title="确定删除？" @confirm="deleteWorkflowItem(row)">
                <template #reference><el-button type="danger" link size="small">删除</el-button></template>
              </el-popconfirm>
            </template>
          </el-table-column>
        </template>
      </el-table>

      <div class="mt-5 flex justify-end">
        <el-pagination background layout="total, prev, pager, next, sizes"
          :current-page="pagination.page" :page-size="pagination.page_size"
          :page-sizes="[8, 12, 20, 30]" :total="pagination.total"
          @current-change="loadWorkflows" @size-change="handleSizeChange" />
      </div>
    </section>

    <!-- 发起工作流对话框 -->
    <el-dialog v-model="createDialogVisible" title="发起工作流 - 双星" width="800px">
      <el-form ref="createFormRef" :model="createForm" :rules="createRules" label-position="top">
        <div class="grid gap-4 md:grid-cols-2">
          <el-form-item label="报备ID" prop="report_id">
            <el-input v-model="createForm.report_id" placeholder="请输入报备ID" />
          </el-form-item>
          <el-form-item label="货号" prop="article_number">
            <el-input v-model="createForm.article_number" placeholder="请输入货号" />
          </el-form-item>
          <el-form-item label="双星系统提报是否通过" prop="ds_system_approval">
            <el-select v-model="createForm.ds_system_approval" class="w-full" placeholder="请选择">
              <el-option label="是" value="是" />
              <el-option label="否" value="否" />
            </el-select>
          </el-form-item>
          <el-form-item label="品牌" prop="ds_brand">
            <el-input v-model="createForm.ds_brand" placeholder="请输入品牌" />
          </el-form-item>
          <el-form-item label="下单颜色" prop="order_color">
            <el-input v-model="createForm.order_color" placeholder="请输入下单颜色" />
          </el-form-item>
          <el-form-item label="数量" prop="quantity">
            <el-input-number v-model="createForm.quantity" class="w-full" :min="0" placeholder="请输入数量" />
          </el-form-item>
          <el-form-item label="选中平台" prop="selected_platform">
            <el-select v-model="createForm.selected_platform" class="w-full" placeholder="请选择平台">
              <el-option label="淘宝" value="淘宝" />
              <el-option label="京东" value="京东" />
              <el-option label="拼多多" value="拼多多" />
              <el-option label="抖音" value="抖音" />
            </el-select>
          </el-form-item>
          <el-form-item label="适用季节" prop="applicable_season">
            <el-select v-model="createForm.applicable_season" class="w-full" placeholder="请选择适用季节">
              <el-option label="春季" value="春季" />
              <el-option label="夏季" value="夏季" />
              <el-option label="秋季" value="秋季" />
              <el-option label="冬季" value="冬季" />
              <el-option label="全季" value="全季" />
            </el-select>
          </el-form-item>
          <el-form-item label="鞋子分类" prop="shoe_category">
            <el-select v-model="createForm.shoe_category" class="w-full" placeholder="请选择鞋子分类">
              <el-option label="单鞋" value="单鞋" />
              <el-option label="网鞋" value="网鞋" />
              <el-option label="棉鞋" value="棉鞋" />
            </el-select>
          </el-form-item>
          <el-form-item label="鞋底材质" prop="sole_material">
            <el-input v-model="createForm.sole_material" placeholder="请输入鞋底材质" />
          </el-form-item>
          <el-form-item label="鞋垫（跟单）" prop="shoe_insole">
            <el-input v-model="createForm.shoe_insole" placeholder="请输入鞋垫" />
          </el-form-item>
          <el-form-item label="款式来源（跟单）" prop="style_source">
            <el-input v-model="createForm.style_source" placeholder="请输入款式来源" />
          </el-form-item>
        </div>
        <el-form-item label="上传图片" prop="images">
          <el-upload action="/api/business/workflows/upload-image/"
            :headers="{ 'Authorization': `Bearer ${authStore.state.accessToken}` }"
            :on-success="handleImageSuccess" :on-error="handleImageError" :on-remove="handleImageRemove"
            :file-list="imageFileList" list-type="picture-card" multiple name="file">
            <el-icon><Plus /></el-icon>
            <template #tip><div class="el-upload__tip">支持上传多张图片</div></template>
          </el-upload>
        </el-form-item>
        <el-form-item label="选择部门审批人" prop="approver">
          <el-select v-model="createForm.approver" class="w-full" placeholder="请选择审批人">
            <el-option v-for="u in users" :key="u.id" :label="u.nickname" :value="u.id" />
          </el-select>
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="createDialogVisible = false">取消</el-button>
        <el-button type="primary" :loading="submitting" @click="submitCreateForm">确定</el-button>
      </template>
    </el-dialog>

    <!-- 工作流详情对话框 -->
    <el-dialog v-model="detailDialogVisible" title="工作流详情" width="900px" top="3vh">
      <div v-if="currentWorkflow" class="space-y-4 max-h-[70vh] overflow-y-auto">
        <div class="border-b pb-4">
          <h4 class="text-lg font-semibold mb-3">基本信息</h4>
          <div class="grid grid-cols-3 gap-4">
            <div><p class="text-sm text-slate-500">报备ID</p><p class="font-medium">{{ currentWorkflow.report_id || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">货号</p><p class="font-medium">{{ currentWorkflow.article_number || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">双星系统提报是否通过</p><p class="font-medium">{{ currentWorkflow.ds_system_approval || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">品牌</p><p class="font-medium">{{ currentWorkflow.ds_brand || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">下单颜色</p><p class="font-medium">{{ currentWorkflow.order_color || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">数量</p><p class="font-medium">{{ currentWorkflow.quantity || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">选中平台</p><p class="font-medium">{{ currentWorkflow.selected_platform || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">适用季节</p><p class="font-medium">{{ currentWorkflow.applicable_season || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">鞋子分类</p><p class="font-medium">{{ currentWorkflow.shoe_category || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">鞋底材质</p><p class="font-medium">{{ currentWorkflow.sole_material || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">鞋垫</p><p class="font-medium">{{ currentWorkflow.shoe_insole || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">款式来源</p><p class="font-medium">{{ currentWorkflow.style_source || '-' }}</p></div>
            <div><p class="text-sm text-slate-500">状态</p>
              <el-tag :type="statusTypeMap[currentWorkflow.status] || 'info'" effect="light">
                {{ statusTextMap[currentWorkflow.status] || currentWorkflow.status }}
              </el-tag>
            </div>
            <div><p class="text-sm text-slate-500">当前阶段</p><p class="font-medium text-blue-600">{{ getStageName(currentWorkflow.current_stage) }}</p></div>
          </div>
          <div v-if="currentWorkflow.images && currentWorkflow.images.length > 0" class="mt-4">
            <p class="text-sm text-slate-500">产品图片</p>
            <div class="flex flex-wrap gap-2 mt-2">
              <el-image v-for="(image, index) in currentWorkflow.images" :key="index"
                :src="image.startsWith('http') ? image : image.startsWith('/media') ? image : `/api${image}`" fit="cover"
                class="w-24 h-24 object-cover rounded"
                :preview-src-list="currentWorkflow.images.map(img => img.startsWith('http') ? img : img.startsWith('/media') ? img : `/api${img}`)"
                :initial-index="index" preview-teleported @error="handleImageLoadError" />
            </div>
          </div>
        </div>

        <div v-if="currentWorkflow.white_background_images && currentWorkflow.white_background_images.length > 0" class="border-b pb-4">
          <h4 class="text-lg font-semibold mb-3">白底照片</h4>
          <div class="flex flex-wrap gap-2">
            <el-image v-for="(image, index) in currentWorkflow.white_background_images" :key="'wb'+index"
              :src="image.startsWith('http') ? image : image.startsWith('/media') ? image : `/api${image}`" fit="cover"
              class="w-24 h-24 object-cover rounded"
              :preview-src-list="currentWorkflow.white_background_images.map(img => img.startsWith('http') ? img : img.startsWith('/media') ? img : `/api${img}`)"
              :initial-index="index" preview-teleported @error="handleImageLoadError" />
          </div>
        </div>

        <div v-if="currentWorkflow.try_on_report && currentWorkflow.try_on_report.length > 0" class="border-b pb-4">
          <h4 class="text-lg font-semibold mb-3">试穿报告</h4>
          <div class="space-y-2">
            <div v-for="(file, index) in currentWorkflow.try_on_report" :key="'tr'+index" class="flex items-center gap-2 p-2 bg-gray-50 rounded">
              <span class="text-sm">文件 {{ index + 1 }}</span>
              <a :href="file.startsWith('http') ? file : file.startsWith('/media') ? file : `/api${file}`" target="_blank" class="text-blue-600 hover:underline text-sm">查看/下载</a>
            </div>
          </div>
        </div>

        <div class="border-b pb-4">
          <h4 class="text-lg font-semibold mb-3">工作流进度</h4>
          <div v-if="currentWorkflow.current_stage === 'eliminated'" class="p-4 bg-red-50 border border-red-200 rounded-lg mb-3">
            <div class="flex items-center gap-2 text-red-600">
              <span class="font-semibold">流程已淘汰</span>
            </div>
            <p v-if="currentWorkflow.eliminate_reason" class="text-sm text-red-500 mt-1">原因：{{ currentWorkflow.eliminate_reason }}</p>
            <p v-if="currentWorkflow.eliminator_name" class="text-sm text-red-500">淘汰人：{{ currentWorkflow.eliminator_name }}</p>
            <p v-if="currentWorkflow.eliminate_time" class="text-sm text-red-500">淘汰时间：{{ formatDateTime(currentWorkflow.eliminate_time) }}</p>
          </div>
          <div class="space-y-3">
            <div v-for="(step, idx) in (currentWorkflow.workflow_type === 'order' ? orderStages : dsStages)" :key="idx"
                 :class="['p-3 rounded-lg border', getStageStatus(currentWorkflow, step.stage) === 'completed' ? 'bg-green-50 border-green-200' : getStageStatus(currentWorkflow, step.stage) === 'current' ? 'bg-blue-50 border-blue-200' : getStageStatus(currentWorkflow, step.stage) === 'rejected' ? 'bg-red-50 border-red-200' : 'bg-gray-50 border-gray-200']">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div :class="['w-7 h-7 rounded-full flex items-center justify-center text-xs font-medium',
                    getStageStatus(currentWorkflow, step.stage) === 'completed' ? 'bg-green-500 text-white' :
                    getStageStatus(currentWorkflow, step.stage) === 'current' ? 'bg-blue-500 text-white' :
                    getStageStatus(currentWorkflow, step.stage) === 'rejected' ? 'bg-red-500 text-white' : 'bg-gray-200 text-gray-500']">
                    {{ getStageStatus(currentWorkflow, step.stage) === 'completed' ? '✓' : getStageStatus(currentWorkflow, step.stage) === 'current' ? '●' : idx + 1 }}
                  </div>
                  <span class="font-medium">{{ step.name }}</span>
                  <span v-if="step.handler" class="text-xs text-slate-400">（{{ getHandlerName(currentWorkflow, step.stage) }}）</span>
                </div>
                <el-tag :type="getStageStatus(currentWorkflow, step.stage) === 'completed' ? 'success' : getStageStatus(currentWorkflow, step.stage) === 'current' ? 'warning' : getStageStatus(currentWorkflow, step.stage) === 'rejected' ? 'danger' : 'info'" size="small">
                  {{ getStageStatus(currentWorkflow, step.stage) === 'completed' ? '已完成' : getStageStatus(currentWorkflow, step.stage) === 'current' ? '进行中' : getStageStatus(currentWorkflow, step.stage) === 'rejected' ? '已淘汰' : '待处理' }}
                </el-tag>
              </div>

              <!-- 当前阶段的操作按钮 -->
              <div v-if="getStageStatus(currentWorkflow, step.stage) === 'current' && canOperateAtStage(currentWorkflow, step.stage)" class="mt-3 ml-9 flex gap-2">
                <el-button type="primary" size="small" :loading="submitting" @click="handleStageConfirm(step.stage, currentWorkflow)">{{ getConfirmButtonText(currentWorkflow, step.stage) }}</el-button>
                <!-- 样品对接流程：阶段3可以淘汰，其他阶段可以拒绝（退回上一步） -->
                <el-button v-if="currentWorkflow?.workflow_type === 'sample' && String(step.stage) !== '1'" :type="step.stage === '3' ? 'danger' : 'warning'" size="small" @click="handleReject">{{ step.stage === '3' ? '淘汰（不做了）' : '拒绝（退回上一步）' }}</el-button>
                <!-- 订单处理流程：阶段2-4可以拒绝（退回上一步） -->
                <el-button v-if="currentWorkflow?.workflow_type === 'order' && step.stage >= 2 && step.stage <= 4" type="warning" size="small" @click="handleOrderReject">拒绝（退回上一步）</el-button>
              </div>

              <div v-if="(getStageStatus(currentWorkflow, step.stage) === 'completed' || getStageStatus(currentWorkflow, step.stage) === 'rejected') && step.stageInfo" class="mt-2 ml-9 text-sm text-slate-600">
                <div v-html="getStageInfoHtml(currentWorkflow, step.stage)"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <template #footer>
        <el-button @click="detailDialogVisible = false">关闭</el-button>
      </template>
    </el-dialog>

    <!-- 部门审批人审核对话框 -->
    <el-dialog v-model="approveDialogVisible" :title="actionDialogTitle" width="600px">
      <el-form ref="actionFormRef" :model="actionForm" label-position="top">
        <template v-if="String(currentWorkflow?.current_stage) === '1' && currentWorkflow?.workflow_type !== 'order'">
          <el-form-item label="选择供应商" prop="supplier" :rules="[{ required: true, message: '请选择供应商', trigger: 'change' }]">
            <el-select v-model="actionForm.supplier" class="w-full" placeholder="请选择供应商" @change="onSupplierChange" clearable>
              <el-option v-for="s in suppliers" :key="s.supplier_name" :label="s.supplier_name" :value="s.supplier_name" />
              <template v-if="suppliers.length === 0">
                <div class="text-center py-2 text-gray-500">暂无供应商数据，请先添加供应商</div>
              </template>
            </el-select>
          </el-form-item>
          <el-form-item label="跟单员（自动获取）">
            <el-input :model-value="actionForm.merchandiser_name" disabled placeholder="根据供应商自动获取" />
          </el-form-item>
          <el-form-item label="备注（选填）">
            <el-input v-model="actionForm.comments" type="textarea" :rows="2" placeholder="请输入备注" />
          </el-form-item>
        </template>

        <!-- 样品对接流程 - 阶段2：跟单员下样品单 -->
        <template v-if="currentWorkflow?.workflow_type === 'sample' && String(currentWorkflow?.current_stage) === '2'">
          <el-form-item label="预计完成时间" prop="expected_completion_time" :rules="[{ required: true, message: '请选择预计完成时间', trigger: 'change' }]">
            <el-date-picker v-model="actionForm.expected_completion_time" class="w-full" type="date" value-format="YYYY-MM-DD" placeholder="请选择预计完成时间" />
          </el-form-item>
          <el-form-item label="适配期货/现货-季节" prop="futures_spot_season">
            <el-input v-model="actionForm.futures_spot_season" placeholder="请输入适配期货/现货-季节" />
          </el-form-item>
          <el-form-item label="选择摄影师" prop="photographer" :rules="[{ required: true, message: '请选择摄影师', trigger: 'change' }]">
            <el-select v-model="actionForm.photographer" class="w-full" placeholder="请选择摄影师">
              <el-option v-for="u in allUsers" :key="u.id" :label="u.nickname" :value="u.id" />
            </el-select>
          </el-form-item>
          <el-form-item label="备注（选填）">
            <el-input v-model="actionForm.comments" type="textarea" :rows="2" placeholder="请输入备注" />
          </el-form-item>
        </template>

        <template v-if="String(currentWorkflow?.current_stage) === '4'">
          <el-form-item label="上传白底照片">
            <el-upload action="/api/business/workflows/upload-image/"
              :headers="{ 'Authorization': `Bearer ${authStore.state.accessToken}` }"
              :on-success="handleWhiteBgSuccess" :on-remove="handleWhiteBgRemove"
              :file-list="whiteBgFileList" list-type="picture-card" multiple name="file">
              <el-icon><Plus /></el-icon>
            </el-upload>
          </el-form-item>
          <el-form-item label="备注（选填）">
            <el-input v-model="actionForm.comments" type="textarea" :rows="2" placeholder="请输入备注" />
          </el-form-item>
        </template>

        <template v-if="String(currentWorkflow?.current_stage) === '5'">
          <div class="grid gap-4 md:grid-cols-2">
            <el-form-item label="初期报价（跟单）" prop="initial_price" :rules="[{ required: true, message: '请输入初期报价', trigger: 'blur' }]">
              <el-input-number v-model="actionForm.initial_price" class="w-full" :precision="2" :min="0" />
            </el-form-item>
            <el-form-item label="最终价格" prop="final_price" :rules="[{ required: true, message: '请输入最终价格', trigger: 'blur' }]">
              <el-input-number v-model="actionForm.final_price" class="w-full" :precision="2" :min="0" />
            </el-form-item>
            <el-form-item label="价格明细" class="md:col-span-2">
              <el-input v-model="actionForm.price_details" type="textarea" :rows="2" placeholder="请输入价格明细" />
            </el-form-item>
            <el-form-item label="价格是否提交">
              <el-select v-model="actionForm.price_submitted" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="价格提交日期">
              <el-date-picker v-model="actionForm.price_submit_date" class="w-full" type="date" value-format="YYYY-MM-DD" />
            </el-form-item>
            <el-form-item label="价格审批是否完成">
              <el-select v-model="actionForm.price_approval_completed" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="未下单原因">
              <el-input v-model="actionForm.unordered_reason" placeholder="请输入未下单原因" />
            </el-form-item>
            <el-form-item label="双星6张图是否上传">
              <el-select v-model="actionForm.ds_six_images_uploaded" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="双星6张图是否合格">
              <el-select v-model="actionForm.ds_six_images_qualified" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="选择价格核算人员" prop="price_calculator" :rules="[{ required: true, message: '请选择价格核算人员', trigger: 'change' }]">
              <el-select v-model="actionForm.price_calculator" class="w-full" placeholder="请选择价格核算人员">
                <el-option v-for="u in allUsers" :key="u.id" :label="u.nickname" :value="u.id" />
              </el-select>
            </el-form-item>
          </div>
        </template>

        <template v-if="String(currentWorkflow?.current_stage) === '6'">
          <div class="mb-4 p-3 bg-gray-50 rounded">
            <p class="text-sm text-slate-500 mb-1">初价信息</p>
            <p>初期报价：¥{{ currentWorkflow.initial_price || '-' }} | 最终价格：¥{{ currentWorkflow.final_price || '-' }}</p>
            <p class="text-sm text-slate-500 mt-1">{{ currentWorkflow.price_details || '' }}</p>
          </div>
          <el-form-item label="选择文员" prop="clerk" :rules="[{ required: true, message: '请选择文员', trigger: 'change' }]">
            <el-select v-model="actionForm.clerk" class="w-full" placeholder="请选择文员" clearable>
              <el-option v-for="u in allUsers" :key="u.id" :label="u.nickname" :value="u.id" />
            </el-select>
          </el-form-item>
          <el-form-item label="选择价格核算人员直属领导" prop="price_leader" :rules="[{ required: true, message: '请选择直属领导', trigger: 'change' }]">
            <el-select v-model="actionForm.price_leader" class="w-full" placeholder="请选择直属领导" clearable>
              <el-option v-for="u in allUsers" :key="u.id" :label="u.nickname" :value="u.id" />
            </el-select>
          </el-form-item>
        </template>

        <template v-if="String(currentWorkflow?.current_stage) === '9'">
          <el-form-item label="上传试穿报告">
            <el-upload action="/api/business/workflows/upload-image/"
              :headers="{ 'Authorization': `Bearer ${authStore.state.accessToken}` }"
              :on-success="handleReportSuccess" :on-remove="handleReportRemove"
              :file-list="reportFileList" multiple name="file">
              <el-button type="primary">上传文件</el-button>
              <template #tip><div class="el-upload__tip">支持PDF、图片、Excel等文件</div></template>
            </el-upload>
          </el-form-item>
        </template>

        <template v-if="String(currentWorkflow?.current_stage) === '10'">
          <div class="grid gap-4 md:grid-cols-2">
            <el-form-item label="是否拍白底图">
              <el-select v-model="actionForm.need_white_bg_photo" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="白底图是否通过">
              <el-select v-model="actionForm.white_bg_passed" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="白底图未过说明" class="md:col-span-2">
              <el-input v-model="actionForm.white_bg_fail_reason" placeholder="请输入白底图未过说明" />
            </el-form-item>
            <el-form-item label="是否有试穿报告">
              <el-select v-model="actionForm.has_try_on_report" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="辅料材质">
              <el-input v-model="actionForm.accessory_material" placeholder="请输入辅料材质" />
            </el-form-item>
            <el-form-item label="是否下单">
              <el-select v-model="actionForm.is_ordered" class="w-full" placeholder="请选择">
                <el-option label="是" value="是" /><el-option label="否" value="否" />
              </el-select>
            </el-form-item>
            <el-form-item label="下单日期">
              <el-date-picker v-model="actionForm.ds_order_date" class="w-full" type="date" value-format="YYYY-MM-DD" />
            </el-form-item>
            <el-form-item label="寄拍日期">
              <el-date-picker v-model="actionForm.photo_shoot_date" class="w-full" type="date" value-format="YYYY-MM-DD" />
            </el-form-item>
            <el-form-item label="寄拍备注" class="md:col-span-2">
              <el-input v-model="actionForm.photo_shoot_remarks" type="textarea" :rows="2" placeholder="请输入寄拍备注" />
            </el-form-item>
          </div>
        </template>

        <template v-if="String(currentWorkflow?.current_stage) === '11'">
          <el-form-item label="备注（选填）">
            <el-input v-model="actionForm.comments" type="textarea" :rows="2" placeholder="请输入备注" />
          </el-form-item>
        </template>

        <!-- 订单处理流程表单 -->
        <template v-if="currentWorkflow?.workflow_type === 'order'">
          <template v-if="currentWorkflow?.order_stage === 1">
            <div class="bg-green-50 p-4 rounded-lg mb-4">
              <h4 class="text-center font-semibold text-green-700">新款生产订单</h4>
              <p class="text-center text-sm text-slate-500 mt-1">图片仅做参考，细节与跟单确定</p>
            </div>

            <div class="grid grid-cols-4 gap-4 mb-4">
              <div>
                <p class="text-sm text-slate-500">跟单</p>
                <p class="font-medium">{{ currentWorkflow?.merchandiser_name || '-' }}</p>
              </div>
              <div>
                <p class="text-sm text-slate-500">下单日期</p>
                <p class="font-medium">{{ formatDateTime(new Date()).split(' ')[0] }}</p>
              </div>
              <div>
                <p class="text-sm text-slate-500">供应商</p>
                <p class="font-medium">{{ currentWorkflow?.supplier || '-' }}</p>
              </div>
              <div>
                <p class="text-sm text-slate-500">仓储方</p>
                <el-input v-model="actionForm.warehouse" placeholder="请输入仓储方" class="w-full no-round" />
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full border-collapse">
                <thead>
                  <tr class="bg-gray-100">
                    <th class="border p-2 text-center" style="min-width: 160px;">工厂款号/图片</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">颜色</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">侧标</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">后柱织带</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">里子布</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">底材</th>
                    <th class="border p-2 text-center" style="min-width: 100px;">商品编码</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">尺码</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">箱数</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">双数</th>
                    <th class="border p-2 text-center" style="min-width: 80px;">总数</th>
                    <th class="border p-2 text-center" style="min-width: 60px;">操作</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="(item, index) in actionForm.order_items" :key="index" class="hover:bg-gray-50">
                    <td class="border p-2">
                      <div class="flex items-center gap-2">
                        <el-upload
                          action="/api/business/workflows/upload-image/"
                          :headers="{ 'Authorization': `Bearer ${authStore.state.accessToken}` }"
                          :on-success="(response) => handleOrderItemImageSuccess(response, index)"
                          class="w-12 h-12 border-dashed border-2 border-slate-300 rounded flex items-center justify-center cursor-pointer"
                          accept="image/*"
                        >
                          <el-image v-if="item.image" :src="item.image" fit="cover" class="w-12 h-12 rounded" />
                          <el-icon v-else><Plus /></el-icon>
                        </el-upload>
                        <el-input v-model="item.factory_style_number" placeholder="工厂款号" class="w-24" />
                      </div>
                    </td>
                    <td class="border p-2"><input v-model="item.color" placeholder="颜色" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><input v-model="item.side_label" placeholder="侧标" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><input v-model="item.back_column_webbing" placeholder="后柱织带" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><input v-model="item.lining_cloth" placeholder="里子布" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><input v-model="item.bottom_material" placeholder="底材" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><input v-model="item.product_code" placeholder="商品编码" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><input v-model="item.size" placeholder="尺码" style="width: 100%; padding: 4px; border: 1px solid #dcdfe6; border-radius: 4px;" /></td>
                    <td class="border p-2"><el-input-number v-model="item.box_count" :min="0" placeholder="箱数" /></td>
                    <td class="border p-2"><el-input-number v-model="item.pair_count" :min="0" placeholder="双数" /></td>
                    <td class="border p-2"><el-input-number v-model="item.total_count" :min="0" placeholder="总数" /></td>
                    <td class="border p-2 text-center">
                      <el-button type="primary" link @click="copyOrderItem(index)">复制</el-button>
                      <el-button type="danger" link @click="removeOrderItem(index)">删除</el-button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="mt-3">
              <el-button type="primary" @click="addOrderItem">添加行</el-button>
            </div>
          </template>

          <template v-if="currentWorkflow?.order_stage === 2">
            <div class="text-center py-4">
              <el-checkbox v-model="actionForm.material_verified" size="large">确认材质无误</el-checkbox>
            </div>
          </template>

          <template v-if="currentWorkflow?.order_stage === 3">
            <el-form-item label="运营审核数据价格">
              <el-input v-model="actionForm.comments" type="textarea" :rows="3" placeholder="请输入审核意见" />
            </el-form-item>
            <el-form-item label="选择部门领导" prop="order_leader" :rules="[{ required: true, message: '请选择部门领导', trigger: 'change' }]">
              <el-select v-model="actionForm.order_leader" class="w-full" placeholder="请选择部门领导">
                <el-option v-for="u in allUsers" :key="u.id" :label="u.nickname" :value="u.id" />
              </el-select>
            </el-form-item>
          </template>

          <template v-if="currentWorkflow?.order_stage === 4">
            <el-form-item label="运营部门领导审核">
              <el-input v-model="actionForm.comments" type="textarea" :rows="3" placeholder="请输入审核意见" />
            </el-form-item>
          </template>
        </template>
      </el-form>
      <template #footer>
        <el-button @click="approveDialogVisible = false">取消</el-button>
        <el-button
          type="primary"
          :loading="submitting"
          @click="handleConfirmClick">
          确认
        </el-button>
        <!-- 拒绝按钮：样品对接阶段3（样品会确认）可以拒绝（淘汰） -->
        <el-button v-if="currentWorkflow?.workflow_type === 'sample' && String(currentWorkflow?.current_stage) === '3'" type="danger" @click="handleReject">淘汰（不做）</el-button>
        <!-- 拒绝按钮：订单处理阶段2-4可以拒绝（退回上一步） -->
        <el-button v-if="currentWorkflow?.workflow_type === 'order' && currentWorkflow?.order_stage >= 2 && currentWorkflow?.order_stage <= 4" type="warning" @click="handleOrderReject">拒绝（退回上一步）</el-button>
      </template>
    </el-dialog>

    <!-- 确认寄拍对话框 -->
    <el-dialog v-model="photoShootDialogVisible" title="确认寄拍" width="400px">
      <p class="mb-4">请选择是否需要寄拍：</p>
      <div class="flex gap-3 justify-center">
        <el-button type="primary" @click="submitPhotoShoot(false)">不需要寄拍</el-button>
        <el-button type="warning" @click="showPhotoShootForm">需要寄拍</el-button>
      </div>
    </el-dialog>
  </div>
</template>

<script setup>
